        {
          "kind": "group",
          "path": "Application",
          "children": [
            { "path": "App.swift", "encoding": "utf8", "target-membership": [ "BsuirScheduleApp/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Resources",
          "children": [
            { "path": "AppIconStandart.icon", "target-membership": [ "BsuirScheduleApp/resources" ] },
            { "path": "AppIconBsuirDonalds.icon", "target-membership": [ "BsuirScheduleApp/resources" ] },
            { "path": "AppIconNostalgia.icon", "target-membership": [ "BsuirScheduleApp/resources" ] },
            { "path": "AppIconPremium.icon", "target-membership": [ "BsuirScheduleApp/resources" ] },
            { "path": "Localizable.xcstrings", "target-membership": [ "BsuirScheduleApp/resources" ] },
            { "path": "Assets.xcassets", "target-membership": [ "BsuirScheduleApp/resources" ] },
            {
              "kind": "variant-group",
              "name": "LaunchScreen.storyboard",
              "target-membership": [
                "BsuirScheduleApp/resources",
              ],
              "children": [
                {
                  "path": "Base.lproj/LaunchScreen.storyboard",
                },
              ],
            },
            { "path": "Info.plist" },
            {
              "kind": "group",
              "path": "Preview Content",
              "children": [
                { "path": "Preview Assets.xcassets", "target-membership": [ "BsuirScheduleApp/resources" ] },
                { "path": "151004.json", "target-membership": [ "BsuirScheduleApp/resources" ] },
                { "path": "groups.json", "target-membership": [ "BsuirScheduleApp/resources" ] },
                { "path": "employees.json", "target-membership": [ "BsuirScheduleApp/resources" ] },
                { "path": "010101.json", "target-membership": [ "BsuirScheduleApp/resources" ] },
              ],
            },
            { "path": "PremiumClubProducts.storekit" },
            {
              "path": "PrivacyInfo.xcprivacy",
              "target-membership": [
                "BsuirScheduleApp/resources",
                "ScheduleWidgetExtension/resources",
              ],
            },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "ScheduleWidget",
      "children": [
        {
          "kind": "group",
          "path": "Widgets",
          "children": [
            { "path": "ScheduleWidgetBundle.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
            { "path": "PinnedScheduleWidget.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
            { "path": "ExamsScheduleWidget.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Provider",
          "children": [
            {
              "kind": "group",
              "path": "Exams",
              "children": [
                { "path": "ExamsScheduleEntry.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "ExamsScheduleEntry+MostRelevant.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "MostRelevantExamsScheduleResponse.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "ExamsScheduleProvider.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "path": "Pinned",
              "children": [
                { "path": "PinnedScheduleEntry.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "PinnedScheduleEntry+MostRelevant.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "PinnedScheduleEntry+WidgetPreview.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "MostRelevantPinnedScheduleResponse.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
                { "path": "PinnedScheduleProvider.swift", "target-membership": [ "ScheduleWidgetExtension/compile-sources" ] },
