{
  "organization": "Saute",
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Config/Base.xcconfig" },
    { "name": "Release", "file": "Config/Base.xcconfig" },
  ],
  "localizations": {
    "development": "ru",
    "supported": [
      "Base",
      "be",
      "en",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-composable-architecture.git",
      "version": {
        "up-to-next-major-version": "1.26.2",
      },
    },
  ],
  "files": [
    {
      "kind": "group",
