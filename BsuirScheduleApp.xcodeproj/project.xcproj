        { "path": "AppStoreSnapshotsUITests.swift", "target-membership": [ "AppStoreSnapshotsUITests/compile-sources" ] },
      ],
    },
    { "kind": "folder", "path": "BsuirScheduleWatchApp", "target-membership": [ "BsuirScheduleWatchApp" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/BsuirScheduleApp.app", "id": "E6F931B222F8B1C10038FC43", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ScheduleWidgetExtension.appex", "id": "E6AA8D0F25162F1A00788A02", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "BsuirScheduleApp/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/AppStoreSnapshotsUITests.xctest", "id": "E6E188592A894EF200658AA8", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/BsuirScheduleWatchApp.app", "id": "E6F38CC930AF960200B303BF", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "BsuirScheduleApp/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "ScheduleWidgetExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "ScheduleWidgetExtension/frameworks" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "BsuirScheduleApp",
      "id": "E6F931B122F8B1C10038FC43",
      "product": "Products/BsuirScheduleApp.app",
      "product-type": "application",
      "dependencies": [
        "ScheduleWidgetExtension",
        "BsuirScheduleWatchApp",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "package-product-members": [
        {
          "product-name": "AppFeature",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIconStandart",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "BsuirScheduleApp/BsuirScheduleApp.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_ASSET_PATHS": "BsuirScheduleApp/Resources/Preview\\ Content",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "BsuirScheduleApp/Resources/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.saute.Bsuir-Schedule",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
      },
    }, {
      "name": "ScheduleWidgetExtension",
      "id": "E6AA8D0E25162F1A00788A02",
      "product": "Products/ScheduleWidgetExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "BsuirApi",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "BsuirUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Deeplinking",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Favorites",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ScheduleCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
        "CODE_SIGN_ENTITLEMENTS": "ScheduleWidgetExtension.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "INFOPLIST_FILE": "ScheduleWidget/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.saute.Bsuir-Schedule.ScheduleWidget",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SKIP_INSTALL": "YES",
      },
    }, {
      "name": "AppStoreSnapshotsUITests",
      "id": "E6E188582A894EF200658AA8",
      "product": "Products/AppStoreSnapshotsUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "BsuirScheduleApp",
      "dependencies": [
        "BsuirScheduleApp",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.asiliuk.AppStoreSnapshotsUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE": "",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "BsuirScheduleApp",
      },
    }, {
      "name": "BsuirScheduleWatchApp",
      "id": "E6F38CC830AF960200B303BF",
      "product": "Products/BsuirScheduleWatchApp.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "BsuirApi",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-composable-architecture",
          "product-name": "ComposableArchitecture",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_PREVIEWS": "YES",
        "GCC_C_LANGUAGE_STANDARD": "gnu17",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "BsuirScheduleWatchApp",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "INFOPLIST_KEY_WKCompanionAppBundleIdentifier": "com.saute.Bsuir-Schedule",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.saute.Bsuir-Schedule.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "TARGETED_DEVICE_FAMILY": "4",
        "WATCHOS_DEPLOYMENT_TARGET": "26.6",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
